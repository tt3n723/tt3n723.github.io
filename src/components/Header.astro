---
/**
 * 导航栏。结构参照 Firefly：
 *   左：站点名   中：文字导航（"文章"是下拉）   右：四个图标
 * 右侧图标依次是：搜索（跳 /search）、音乐（弹层）、主题设置（色相滑杆）、明暗切换（三态菜单）。
 * 面板与滚动行为在 src/scripts/header.ts。
 */
import MusicPlayer from './MusicPlayer.astro';
import { NAV_LINKS, SITE_HUE, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const isGroupActive = (item: (typeof NAV_LINKS)[number]) =>
  (item.children ?? []).some((child) => isActive(child.href));

// 8 个经典色相（作者：预设不用那么多，几个经典的就行）。
// 色相按 0 → 330 大致均匀分布，一行放得下。
// 纸面色调预设。和「主题色相」是**两件独立的事**，可以自由组合
// （比如「暖纸 + 靛蓝主题色」）。改的是 --paper-h / --paper-c。
const palettes = [
  { label: '默认', value: 'default', bg: 'oklch(0.975 0.005 var(--hue))' },
  { label: '暖纸', value: 'warm', bg: 'oklch(0.975 0.028 68)' },
  { label: '护眼绿', value: 'green', bg: 'oklch(0.975 0.03 148)' },
  { label: '雾青', value: 'mist', bg: 'oklch(0.975 0.02 198)' },
  { label: '藕荷', value: 'rose', bg: 'oklch(0.975 0.016 18)' },
  { label: '纯灰', value: 'plain', bg: 'oklch(0.975 0 0)' },
];

const hues = [
  { label: '红', value: 0 },
  { label: '橙红', value: 25 },
  { label: '琥珀', value: 60 },
  { label: '绿', value: 160 },
  { label: '青', value: 200 },
  { label: '蓝', value: 230 },
  { label: '普鲁士蓝', value: 245 },
  { label: '靛蓝', value: 265 },
  { label: '洋红', value: 330 },
];
---

<header id="site-header" class="site-header" data-pagefind-ignore>
  <div class="site-nav">
    <a href="/" class="brand">{SITE_TITLE}</a>

    <nav class="nav-menu" aria-label="主导航">
      {
        NAV_LINKS.map((item) =>
          item.children ? (
            <div class="nav-item has-children">
              <button
                type="button"
                class:list={['nav-link', 'nav-trigger', isGroupActive(item) && 'is-active']}
                data-dropdown-trigger
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
              <div class="nav-dropdown">
                {item.children.map((child) => (
                  <a href={child.href} class:list={['nav-dropdown-link', isActive(child.href) && 'is-active']}>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} class:list={['nav-link', isActive(item.href!) && 'is-active']}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="nav-icons">
      <button type="button" class="icon-btn" data-search-open aria-label="搜索" title="搜索（Ctrl/⌘ + K）">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </button>

      <button type="button" class="icon-btn" data-panel-trigger="music" aria-label="音乐" title="音乐" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18V5l10-2v13" />
          <circle cx="6" cy="18" r="3" />
          <circle cx="16" cy="16" r="3" />
        </svg>
      </button>

      <button type="button" class="icon-btn" data-panel-trigger="settings" aria-label="主题设置" title="主题设置" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a9 9 0 1 0 0 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-.9.7-1.5 1.5-1.5H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7z" />
          <circle cx="7.5" cy="11.5" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="11" cy="7.5" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="16" cy="9.5" r="1.2" fill="currentColor" stroke="none" />
        </svg>
      </button>

      <button type="button" class="icon-btn" data-theme-toggle aria-label="切换明暗" title="切换明暗">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      <button type="button" class="icon-btn icon-btn-menu" data-panel-trigger="menu" aria-label="菜单" title="菜单" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="float-panel panel-wide" id="panel-music" data-panel="music" hidden>
    <MusicPlayer />
  </div>

  <div class="float-panel panel-wide" id="panel-settings" data-panel="settings" hidden>
    <div class="panel-head">
      <p class="section-title">外观</p>
      <button type="button" class="panel-reset" data-settings-reset aria-label="恢复默认设置" title="恢复默认设置">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3-6.7" />
          <path d="M3 4v5h5" />
        </svg>
      </button>
              <button
                class="panel-reset"
                type="button"
                data-cache-reset
                title="清掉离线缓存并重新加载（改了博客看不到新内容时点这个）"
                aria-label="强制更新"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
              </button>
    </div>

    <label class="setting-row"><span>纸面色调</span></label>
    <div class="palette-presets">
      {
        palettes.map((p) => (
          <button
            type="button"
            class="palette-swatch"
            data-palette={p.value}
            title={p.label}
            aria-label={p.label}
          >
            <span style={`background: ${p.bg}`} />
          </button>
        ))
      }
    </div>
    <label class="setting-row" for="hue-range">
      <span>主题色相</span>
      <output id="hue-value">{SITE_HUE}</output>
    </label>
    <input id="hue-range" class="range" type="range" min="0" max="360" step="5" value={SITE_HUE} aria-label="全站色相" />
    <div class="hue-presets">
      {
        hues.map((preset) => (
          <button type="button" class="hue-swatch" data-hue={preset.value} title={preset.label} aria-label={preset.label}>
            <span style={`background: oklch(0.62 0.16 ${preset.value})`} />
          </button>
        ))
      }
    </div>

    <p class="section-title">排版</p>
    <label class="setting-row" for="prose-size">
      <span>正文字号</span>
      <output id="prose-size-value">100%</output>
    </label>
    <input id="prose-size" class="range" type="range" min="90" max="115" step="1" value="100" aria-label="正文字号" />

    <label class="setting-row" for="prose-leading">
      <span>正文行距</span>
      <output id="prose-leading-value">175%</output>
    </label>
    <input id="prose-leading" class="range" type="range" min="150" max="210" step="5" value="175" aria-label="正文行距" />

    <label class="setting-row" for="code-size">
      <span>代码字号</span>
      <output id="code-size-value">88%</output>
    </label>
    <input id="code-size" class="range" type="range" min="72" max="108" step="1" value="88" aria-label="代码字号" />

    <p class="section-title">文章列表</p>
    <div class="btn-group" role="group" aria-label="文章列表布局">
      <button type="button" data-layout="list">列表</button>
      <button type="button" data-layout="grid">网格</button>
    </div>

    <p class="section-title">效果</p>
    <button type="button" class="switch-row" data-toggle="sakura" role="switch" aria-checked="false">
      <span>樱花特效</span>
      <span class="switch-track"><span class="switch-knob" /></span>
    </button>

    <button type="button" class="switch-row" data-toggle="fireworks" role="switch" aria-checked="false">
      <span>点击烟花</span>
      <span class="switch-track"><span class="switch-knob" /></span>
    </button>
  </div>

  <div class="mobile-scrim" data-panel="menu" hidden></div>
  <aside class="mobile-drawer" id="panel-menu" data-panel="menu" hidden aria-label="菜单">
    <div class="drawer-head">
      <span>{SITE_TITLE}</span>
      <button type="button" class="icon-btn" data-panel-close aria-label="关闭">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <nav class="drawer-nav">
      {
        NAV_LINKS.map((item) =>
          item.children ? (
            <div class="drawer-group">
              <span class="drawer-group-label">{item.label}</span>
              {item.children.map((child) => (
                <a href={child.href} class:list={['drawer-link', isActive(child.href) && 'is-active']}>{child.label}</a>
              ))}
            </div>
          ) : (
            <a href={item.href} class:list={['drawer-link', isActive(item.href!) && 'is-active']}>{item.label}</a>
          ),
        )
      }
    </nav>

    <div class="drawer-actions">
      <button type="button" class="drawer-action" data-search-open aria-label="搜索" title="搜索">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </button>
      <button type="button" class="drawer-action" data-panel-trigger="music" aria-label="音乐" title="音乐">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l10-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="16" cy="16" r="3" /></svg>
      </button>
      <button type="button" class="drawer-action" data-panel-trigger="settings" aria-label="主题设置" title="主题设置">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-.9.7-1.5 1.5-1.5H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7z" /></svg>
      </button>
      <button type="button" class="drawer-action" data-theme-toggle aria-label="切换明暗" title="切换明暗">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4" /></svg>
      </button>
    </div>
  </aside>
</header>

<style>
  /* 导航栏浮在头图上面（Fluid 就是这样），滚动后才变成实底 */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    /* F（优化版）：四周留出内边距 —— 导航栏从视口顶边"脱开"一点，
       这样上方两个圆角才看得见。 */
    padding: 0.5rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.22s ease;
  }
  .site-header.is-hidden {
    transform: translateY(-120%);
    opacity: 0;
  }

  .site-nav {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    height: 4rem;
    max-width: 100rem;
    margin: 0 auto;
    padding: 0 0.75rem;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    background: transparent;
    transition: background-color 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.28s cubic-bezier(0.4, 0, 0.2, 1), backdrop-filter 0.28s ease;
  }
  /* ---- 顶部未滚动：完全透明 + 白字（压在头图上）---- */
  /* 压在花哨的头图上时，白字需要一层很淡的暗描边才读得清
     （头图的遮罩只有 0.3，亮色区域白字会糊） */
  .site-header:not(.is-scrolled) .brand,
  .site-header:not(.is-scrolled) .nav-link,
  .site-header:not(.is-scrolled) .icon-btn {
    color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5), 0 0 12px rgba(0, 0, 0, 0.25);
  }
  .site-header:not(.is-scrolled) .brand:hover,
  .site-header:not(.is-scrolled) .nav-link:hover,
  .site-header:not(.is-scrolled) .nav-link.is-active,
  .site-header:not(.is-scrolled) .icon-btn:hover,
  .site-header:not(.is-scrolled) .icon-btn[aria-expanded='true'] {
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
  }
  .site-header:not(.is-scrolled) .icon-moon {
    display: none;
  }
  .site-header:not(.is-scrolled) .icon-sun {
    display: block;
  }
  /* ---- 滚动后：毛玻璃，**按主题色**、颜色更浅 ---- */
    .site-header.is-scrolled .site-nav {
    border-color: var(--glass-border);
    background: var(--glass-bg);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 8px 28px color-mix(in srgb, var(--accent) 14%, transparent);
    backdrop-filter: blur(24px) saturate(1.2);
  }
  html.dark .site-header.is-scrolled .site-nav {
    background: color-mix(in oklch, var(--surface) 52%, transparent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 8px 26px rgba(0, 0, 0, 0.3);
  }
  /* 滚动后也用白字（和顶部态一致）。
     因为玻璃底色已经很淡（--glass-bg 的透明度 0.15），
     深色字压在"透上来的背景"上会读不清，索性用白字 + 一层暗描边。 */
  .site-header.is-scrolled .brand,
  .site-header.is-scrolled .nav-link,
  .site-header.is-scrolled .icon-btn {
    color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5), 0 0 12px rgba(0, 0, 0, 0.25);
  }
  .site-header.is-scrolled .brand:hover,
  .site-header.is-scrolled .nav-link:hover,
  .site-header.is-scrolled .nav-link.is-active,
  .site-header.is-scrolled .icon-btn:hover,
  .site-header.is-scrolled .icon-btn[aria-expanded='true'] {
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
  }
  /* 顶部透明态下，下拉菜单仍然是实底的 */
  .site-header:not(.is-scrolled) .nav-dropdown {
    background: var(--surface);
  }

  .brand {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color 0.15s;
  }
  .brand:hover {
    color: var(--accent);
  }

  .nav-menu {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }
  @media (min-width: 1024px) {
    .nav-menu {
      display: flex;
    }
  }
  .nav-item {
    position: relative;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.5rem;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 0.6rem;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }
  .nav-link:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .nav-link.is-active {
    color: var(--accent);
  }
  .chevron {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.2s;
  }
  .nav-item.has-children:hover .chevron,
  .nav-item.has-children:focus-within .chevron {
    transform: rotate(180deg);
  }
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 9rem;
    margin-top: 0.25rem;
    padding: 0.4rem;
    border: 1px solid color-mix(in oklab, var(--line) 70%, transparent);
    border-radius: 0.875rem;
    background: var(--surface);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.16s, transform 0.16s, visibility 0.16s;
  }
  .nav-item.has-children:hover .nav-dropdown,
  .nav-item.has-children:focus-within .nav-dropdown,
  .nav-item.has-children.is-open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-dropdown-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.6rem;
    color: var(--fg);
    font-size: 0.875rem;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }
  .nav-dropdown-link:hover,
  .nav-dropdown-link.is-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .nav-icons {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 0.6rem;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s, transform 0.1s;
  }
  .icon-btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .icon-btn:hover,
  .icon-btn[aria-expanded='true'] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .icon-btn:active {
    transform: scale(0.92);
  }
  @media (min-width: 1024px) {
    .icon-btn-menu {
      display: none;
    }
  }
  .icon-moon {
    display: none;
  }
  html.dark .icon-sun {
    display: none;
  }
  html.dark .icon-moon {
    display: block;
  }

  .float-panel {
    position: absolute;
    top: calc(4rem + 0.5rem);
    right: 1rem;
    /* 「小家碧玉」：面板本身、里面的字号和控件全部收小 */
    width: 13rem;
    font-size: 0.76rem;
    /* 内容可能比视口还高（设置面板曾经 880px、超出屏幕 67px） */
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 0.55rem;
    border: 1px solid color-mix(in oklab, var(--line) 70%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklch, var(--surface) 94%, transparent);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(16px) saturate(1.4);
    z-index: 70;
  }
  .float-panel.panel-wide {
    width: 14.5rem;
  }
  .float-panel[hidden] {
    display: none;
  }
  /* 面板顶行：「外观」标题在左，「恢复默认」按钮在右，同一行 */
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }
  /* 顶行里的标题不要上下 margin —— 那会让这一行被撑开 */
  .panel-head .section-title {
    margin: 0;
  }
