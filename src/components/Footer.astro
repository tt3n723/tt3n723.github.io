---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

{/* 作者："不要分类、关于那些，只要左边的，然后居中。"
    所以这里只剩一行版权，居中排布。 */}
<footer class="site-footer" data-pagefind-ignore>
  <p class="footer-copy">
    © {year} {SITE_AUTHOR} · {SITE_TITLE}
  </p>

  <style>
    .site-footer {
      margin-top: 3rem;
      border-top: 1px solid var(--line);
      padding: 3rem 1rem 3.5rem;
    }
    .footer-copy {
      margin: 0;
      text-align: center;
      font-size: 0.82rem;
      letter-spacing: 0.03em;
      color: color-mix(in srgb, var(--muted) 85%, transparent);
    }
  </style>
</footer>
