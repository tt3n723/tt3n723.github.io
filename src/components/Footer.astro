---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10 text-sm text-muted" data-pagefind-ignore>
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 px-4 sm:flex-row sm:justify-between">
    <p>© {year} {SITE_AUTHOR} · {SITE_TITLE}</p>
    <p class="flex items-center gap-4">
      <a href="/categories" class="transition hover:text-accent">分类</a>
      <a href="/tags" class="transition hover:text-accent">标签</a>
      <a href="/about" class="transition hover:text-accent">关于</a>
    </p>
  </div>
</footer>
