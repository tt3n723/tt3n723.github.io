---
/**
 * 音乐播放器（导航栏"音乐"图标点开的那个弹层）。
 *
 * 形态参照 Firefly：封面 + 歌名/歌手 + 进度条 + 上一首/播放/下一首 + 歌单。
 * <audio> 由 src/scripts/music.ts **在你第一次点播放时**才创建，
 * 不点就完全不会下载音频文件。
 */
import { MUSIC_PLAYLIST } from '../data/music';

const first = MUSIC_PLAYLIST[0];
---

{/* transition:persist 让这个节点在客户端路由切换时**不被销毁**，
           <audio> 和播放进度因此能跨页保留 */}
<div class="music-player" data-music-player transition:persist="music-player">
  <p class="panel-title">音乐</p>

  <div class="music-head">
    <div
      class="music-cover"
      data-music-cover
      style={first?.cover ? `background-image: url(${first.cover})` : undefined}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M9 18V5l10-2v13" />
        <circle cx="6" cy="18" r="3" />
        <circle cx="16" cy="16" r="3" />
      </svg>
    </div>
    <div class="music-meta">
      <p class="music-title" data-music-title>{first?.title ?? '暂无歌曲'}</p>
      <p class="music-artist" data-music-artist>{first?.artist ?? ''}</p>
    </div>
  </div>

  <div
    class="music-progress"
    data-music-progress
    role="slider"
    tabindex="0"
    aria-label="播放进度"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span class="music-bar" data-music-bar></span>
  </div>

  <div class="music-row">
    <span class="music-time" data-music-time>0:00 / 0:00</span>
    <div class="music-buttons">
      <button type="button" class="music-btn" data-music-prev aria-label="上一首" title="上一首">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 6h2v12H7zM19 6v12L9.5 12z" />
        </svg>
      </button>
      <button type="button" class="music-btn music-btn-main" data-music-toggle aria-label="播放" title="播放">
        <svg class="music-icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg class="music-icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
        </svg>
      </button>
      <button type="button" class="music-btn" data-music-next aria-label="下一首" title="下一首">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M15 6h2v12h-2zM5 6v12l9.5-6z" />
        </svg>
      </button>
    </div>
  </div>

  <ol class="music-list">
    {
      MUSIC_PLAYLIST.map((track, index) => (
        <li>
          <button
            type="button"
            class="music-item"
            data-music-item
            data-index={index}
            data-src={track.src}
            data-title={track.title}
            data-artist={track.artist}
            data-cover={track.cover ?? ''}
            class:list={[index === 0 && 'is-current']}
          >
            <span class="music-item-index">{index + 1}</span>
            <span class="music-item-title">{track.title}</span>
            <span class="music-item-artist">{track.artist}</span>
          </button>
        </li>
      ))
    }
  </ol>

  {
    MUSIC_PLAYLIST.length === 0 && (
      <p class="panel-note">
        还没有歌。把 mp3 放进 <code>public/music/</code>，再到 <code>src/data/music.ts</code> 里加一行。
      </p>
    )
  }
</div>

<style>
  .music-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .music-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: 0.75rem;
    background-color: color-mix(in srgb, var(--accent) 14%, transparent);
    background-size: cover;
    background-position: center;
    color: var(--accent);
  }
  .music-cover svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .music-meta {
    min-width: 0;
  }
  .music-title {
    font-size: 0.8rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .music-artist {
    font-size: 0.68rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .music-progress {
    height: 0.3rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--muted) 22%, transparent);
    cursor: pointer;
    overflow: hidden;
  }
  .music-progress:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .music-bar {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 9999px;
    background: var(--accent);
    transition: width 0.15s linear;
  }

  .music-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
  }
  .music-time {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .music-buttons {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .music-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.65rem;
    height: 1.65rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s, transform 0.1s;
  }
  .music-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .music-btn:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .music-btn:active {
    transform: scale(0.92);
  }
  .music-btn-main {
    width: 2rem;
    height: 2rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .music-btn-main svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .music-icon-pause {
    display: none;
  }
  .music-player.is-playing .music-icon-play {
    display: none;
  }
  .music-player.is-playing .music-icon-pause {
    display: block;
  }

  .music-list {
    margin: 0.75rem 0 0;
    padding: 0.5rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    max-height: 8rem;
    overflow-y: auto;
  }
  .music-item {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    width: 100%;
    padding: 0.32rem 0.4rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: 0.72rem;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .music-item:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .music-item.is-current {
    color: var(--accent);
    font-weight: 600;
  }
  .music-item-index {
    flex-shrink: 0;
    width: 1rem;
    color: var(--muted);
    font-size: 0.7rem;
  }
  .music-item-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .music-item-artist {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.7rem;
  }
</style>
