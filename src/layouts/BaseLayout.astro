---
import { ClientRouter } from 'astro:transitions';
import BackToTop from '../components/BackToTop.astro';
import SearchModal from '../components/SearchModal.astro';
import Banner from '../components/Banner.astro';
import 'katex/dist/katex.min.css';
import 'katex/dist/contrib/mhchem.mjs'; // 支持 \ce{} 化学式
import '../styles/global.css';
import Header from '../components/Header.astro';
// KaTeX 字体：用 ?url 拿到**和 CSS 里同一个**哈希文件名，才能命中缓存。
// 只在需要公式的页面真正渲染 <link rel="preload">（见下面的 preloadMath）。
import katexAms from 'katex/dist/fonts/KaTeX_AMS-Regular.woff2?url';
import katexMain from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexMathItalic from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
import katexSize1 from 'katex/dist/fonts/KaTeX_Size1-Regular.woff2?url';
import katexSize2 from 'katex/dist/fonts/KaTeX_Size2-Regular.woff2?url';
import { SITE_DESCRIPTION, SITE_HUE, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 内部页面用：告诉搜索引擎不要收录 */
  noindex?: boolean;
  /**
   * 预加载 KaTeX 字体（文章页开）。
   * 不预加载的话，公式字体是在页面出现之后才一个个到达的；
   * 而 KaTeX 用 font-display: block（字体没到就不显示），
   * 每到一个字体就要整页重算一次样式 —— 5 万节点的文章页上，
   * 这就是主线程被占住、点了链接"没反应"的来源。
   */
  preloadMath?: boolean;
  /**
   * 容器宽度：
   *   default —— 正文/单页，1024px
   *   wide    —— 列表页，铺满
   *   post    —— 文章页，正文列 + 右侧目录
   */
  width?: 'default' | 'wide' | 'post';
  /** 分享图（og:image），文章页传封面 */
  image?: string;
  /** og:type */
  kind?: 'website' | 'article';
  /** 文章发布时间，喂给 article:published_time */
  publishedTime?: string;
  /** 头图上的大字，默认站点名 */
  bannerTitle?: string;
  /** 头图上的小字 */
  bannerSubtitle?: string;
  /** 头图高度，默认 100vh */
  bannerHeight?: string;
  /** 头图换成别的图（关于页用 banner-about.jpg） */
  bannerImage?: string;
  /** 头图标题打字机（首页用） */
  bannerTyped?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  noindex = false,
  preloadMath = false,
  width = 'default',
  image,
  kind = 'website',
  publishedTime,
  bannerTitle,
  bannerSubtitle,
  bannerHeight,
  bannerImage,
  bannerTyped,
} = Astro.props;

const ogImage = image ? new URL(image, SITE_URL).href : undefined;

// 全站统一宽度：原来 default/wide/post 三种宽度不同，页面之间会「跳」。
const containerClass = {
  default: 'max-w-[72rem]',
  wide: 'max-w-[72rem]',
  post: 'max-w-[72rem]',
}[width];
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="zh-CN" style={`--hue: ${SITE_HUE}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    {
      preloadMath && (
        <>
          <link rel="preload" as="font" type="font/woff2" href={katexMain} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexMathItalic} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexSize1} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexSize2} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexAms} crossorigin="anonymous" />
        </>
      )
    }
    {/* 预加载：等当前页 load 完、浏览器空闲了才去取其他页，不抢首屏带宽。
    作者要的「进来先看首页，其他后台下载」就是这个行为。 */}
<ClientRouter prefetch={{ prefetchAll: true, defaultStrategy: 'load' }} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- 分享卡片。宽度高度按站内封面统一 16:9 的比例给，
         有些平台缺这两个属性就不渲染大图 -->
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={kind} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="675" />
          <meta property="og:image:alt" content={title ?? SITE_TITLE} />
          <meta name="twitter:image" content={ogImage} />
          <meta name="twitter:image:alt" content={title ?? SITE_TITLE} />
        </>
      )
    }
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <!--
      主题初始化必须放在 <head> 里同步执行，否则暗色模式会闪一下白屏（FOUC）。
      所以这里用 is:inline，不参与打包。
    -->
    <script is:inline>
      (function () {
        // 给 <html> 打个 js 标记：CSS 里凡是"需要 JS 才能用"的样式都挂在它下面，
        // 这样禁用 JS 时页面会退化成"全部展开"的安全形态，而不是藏起来打不开。
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('theme') || 'auto';
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var dark = stored === 'dark' || (stored === 'auto' && prefersDark);
          document.documentElement.classList.toggle('dark', dark);

          // 设置面板的色相滑杆会把选择存在 localStorage.hue，这里优先用它，
          // 这样你挑选色相时可以带着它到处翻页。点「恢复默认」即可清除。
          var hue = localStorage.getItem('hue');
          if (hue) document.documentElement.style.setProperty('--hue', hue);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg font-sans text-fg antialiased">
    <div class="reading-progress" aria-hidden="true"><span data-progress-bar></span></div>
    <Header />

    <Banner
      title={bannerTitle}
      subtitle={bannerSubtitle}
      height={bannerHeight}
      image={bannerImage}
      typed={bannerTyped}
    />

    <a href="#main" class="skip-link">跳到主内容</a>
    <main id="main" class:list={['mx-auto w-full px-4 pb-24', containerClass]}>
      <slot />
    </main>
    <SearchModal />

    <BackToTop />

    <script>
      import { initHeader } from '../scripts/header';
      import { initTheme } from '../scripts/theme';
      import { initCopyCode } from '../scripts/copy-code';
      import { initTabs } from '../scripts/tabs';
      import { initToc } from '../scripts/toc';
      import { initMermaid } from '../scripts/mermaid';
      import { initLqip } from '../scripts/lqip';
      import { initMusic } from '../scripts/music';
      import { initLightbox } from '../scripts/lightbox';
      import { initReveal } from '../scripts/reveal';
      import { initBanner } from '../scripts/banner';
      import { initArchive } from '../scripts/archive';
      import { initSeriesNav } from '../scripts/series-nav';
      import { initSearchModal } from '../scripts/search-modal';
      import { initBackToTop } from '../scripts/back-to-top';
      import { initTyped } from '../scripts/typed';
      import { initSakura } from '../scripts/sakura';
      import { initFireworks } from '../scripts/fireworks';
      import { initProgress } from '../scripts/progress';
      import { initSw } from '../scripts/sw';

      // 用 astro:page-load 统一驱动：
      //   - 首次加载会触发一次
      //   - 每次客户端路由切换（ClientRouter）之后再触发一次
      // 这样页面换掉之后，新的 DOM 会被重新挂上事件（导航栏本身也会被替换）。
      // lastPath 防止同一页面被初始化两次（首次加载时两个时机都会到）。
      let lastPath = '';

      function safe(fn: () => void, label: string) {
        try {
          fn();
        } catch (e) {
          console.error('[boot]', label, e);
        }
      }

      function boot() {
        if (location.pathname === lastPath) return;
        lastPath = location.pathname;

        // ClientRouter 换页时会把新页面的 <html> 属性搬过来，
        // 但内联脚本不会重跑，所以 .js 这个类得自己补回来——
        // 少了它，所有"渐进增强"的初始隐藏状态就会失效。
        document.documentElement.classList.add('js');

        initTheme(); // 明暗一键切换的绑定
        safe(initHeader, 'initHeader');
        safe(initCopyCode, 'initCopyCode');
        safe(initTabs, 'initTabs');
        safe(initToc, 'initToc');
  safe(initSw, 'initSw');
        safe(initMermaid, 'initMermaid');
        safe(initLqip, 'initLqip');
        safe(initMusic, 'initMusic');
        safe(initLightbox, 'initLightbox');
        safe(initReveal, 'initReveal');
        safe(initBanner, 'initBanner');
        safe(initArchive, 'initArchive');
        safe(initSeriesNav, 'initSeriesNav');
        safe(initSearchModal, 'initSearchModal');
        safe(initBackToTop, 'initBackToTop');
        safe(initTyped, 'initTyped');
        safe(initSakura, 'initSakura');
        initFireworks(); // 默认不开（html.fireworks-off），设置面板里能打开
        initProgress(); // 顶部阅读进度条
      }

      document.addEventListener('astro:page-load', boot);
      // 兜底：万一 ClientRouter 没生效（astro:page-load 不触发），首屏也要能跑
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot, { once: true });
      } else {
        boot();
      }
    </script>
  </body>
</html>
