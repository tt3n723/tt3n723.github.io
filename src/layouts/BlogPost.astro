---
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import CategoryNav from '../components/CategoryNav.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  id: string;
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  categories?: string[];
  cover?: string;
  headings?: MarkdownHeading[];
  stats?: { chars: number; words: number; minutes: number };
}

const {
  id,
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  categories = [],
  cover,
  headings = [],
  stats,
} = Astro.props;
// 有 h2 才有目录（和 Toc.astro 里的判断一致）。没有目录时右侧那一栏不能留空。
const hasToc = headings.some((h) => h.depth === 2);


// 上一篇 / 下一篇（作者要求补的"操作流程"）
const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const index = all.findIndex((post) => post.id === id);
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;
const newer = index > 0 ? all[index - 1] : undefined;

const dateText = new Intl.DateTimeFormat('zh-CN', {
  dateStyle: 'medium',
  timeZone: 'Asia/Shanghai',
}).format(pubDate);

// 头图上那一行：日期 · 字数 · 阅读时长 · 分类
// 头图上那一行：**只要时间 / 字数 / 阅读时长**（作者要求去掉分类和标签）
const bannerSubtitle = [dateText, stats ? `${stats.chars} 字` : null, stats ? `约 ${stats.minutes} 分钟` : null]
  .filter(Boolean)
  .join(' · ');
---

<BaseLayout
  title={title}
  description={description}
  width="post"
  image={cover}
  kind="article"
  publishedTime={pubDate.toISOString()}
  bannerTitle={title}
  bannerSubtitle={bannerSubtitle}
  {/* 头图用**原始 JPEG**，不做任何压缩 —— 作者要求。
        注意：源图只有 1920×1080，在 2x 屏或 2560 宽的屏上仍然会被放大，
        那个"糊"来自分辨率不足，不是压缩造成的。 */}
  bannerImage={cover}
  bannerHeight="100vh"
  preloadMath
>
  <!-- 正文装进一块白板（和首页同款语言），目录留在板子外面 -->
  <!-- 正文始终在视口居中，不因有没有目录而左右跳。
       目录改为按需显示（右下角浮动按钮 → 右侧抽屉），完全不占文档流。 -->
  <div class="mx-auto w-full max-w-[72rem]">
    <article class="post-board min-w-0" data-pagefind-body>
      <div class="post-board-inner">
        <!-- 标题已经在头图上了；这里给 Pagefind 一个稳的标题来源 -->
        <span class="sr-only" data-pagefind-meta="title">{title}</span>

        <CategoryNav currentId={id} categories={categories} />

        <div
          class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-28 prose-a:no-underline hover:prose-a:underline"
        >
          <slot />
        </div>

        {
          (older || newer) && (
            <nav class="post-neighbors" aria-label="相邻文章">
              {older ? (
                <a class="neighbor" href={`/blog/${older.id}/`}>
                  <span class="neighbor-label">← 上一篇</span>
                  <span class="neighbor-title">{older.data.title}</span>
                </a>
              ) : (
                <span class="neighbor is-empty" />
              )}
              {newer ? (
                <a class="neighbor is-next" href={`/blog/${newer.id}/`}>
                  <span class="neighbor-label">下一篇 →</span>
                  <span class="neighbor-title">{newer.data.title}</span>
                </a>
              ) : (
                <span class="neighbor is-empty" />
              )}
            </nav>
          )
        }
      </div>
    </article>
  </div>

  {hasToc && (
    <>
      <!-- 目录遮罩 -->
      <div class="toc-scrim" data-toc-scrim hidden></div>
      <!-- 目录抽屉：右侧滑入 -->
      <aside class="toc-drawer" data-toc-drawer hidden aria-label="目录">
        <div class="toc-drawer-head">
          <span>目录</span>
          <button type="button" class="toc-drawer-close" data-toc-close aria-label="关闭目录">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
        <Toc headings={headings} />
      </aside>
      <!-- 触发按钮：固定在右下角，回到顶部按钮上方 -->
      <button type="button" class="toc-trigger" data-toc-trigger aria-label="打开目录" title="目录">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h10" />
        </svg>
      </button>
    </>
  )}
</BaseLayout>
