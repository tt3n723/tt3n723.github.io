<script is:inline>
  // ⑨ 三种主题切换方式对比
  document.querySelectorAll('[data-theme-mode]').forEach(function (button) {
    button.addEventListener('click', function () {
      const mode = button.getAttribute('data-theme-mode');
      const root = document.documentElement;
      const toDark = !root.classList.contains('dark');

      const apply = function () {
        // 直接写 class + localStorage，和正式站的主题逻辑保持一致
        localStorage.setItem('theme', toDark ? 'dark' : 'light');
        root.classList.toggle('dark', toDark);
      };

      if (mode === 'instant') {
        root.classList.add('theme-anim-none');
        apply();
        setTimeout(function () { root.classList.remove('theme-anim-none'); }, 100);
      } else if (mode === 'transition') {
        apply();
      } else if (document.startViewTransition) {
        document.startViewTransition(apply);
      } else {
        apply();
      }
    });
  });

  // ⑦ 里那几个 mock 折叠窗口的展开/收起（正文里的真代码块由 copy-code.ts 处理）
  document.querySelectorAll('.fold-code .code-toggle').forEach(function (button) {
    button.addEventListener('click', function () {
      const fold = button.closest('.fold-code');
      if (!fold) return;
      const collapsed = fold.getAttribute('data-collapsed') === 'true';
      fold.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
      button.setAttribute('aria-expanded', String(collapsed));
    });
  });


  // ⑩ 阅读进度条演示
  const progressButton = document.querySelector('[data-progress]');
  if (progressButton) {
    const bar = document.querySelector('.progress-demo span');
    progressButton.addEventListener('click', function () {
      if (!bar) return;
      bar.style.transition = 'none';
      bar.style.width = '0%';
      void bar.offsetWidth;
      bar.style.transition = 'width 2.5s cubic-bezier(0.1, 0.05, 0.1, 1)';
      bar.style.width = '100%';
    });
  }
</script>
