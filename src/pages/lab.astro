---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_HUE } from '../consts';

const huePresets = [
  { label: '靛蓝（默认）', value: 265 },
  { label: '深海蓝', value: 235 },
  { label: '青', value: 195 },
  { label: '松绿', value: 160 },
  { label: '琥珀', value: 65 },
  { label: '橙红', value: 30 },
  { label: '玫红', value: 350 },
  { label: '紫', value: 300 },
];

// ⑤ 顶部导航的新变体（D~H）。每条都会渲染两个状态：压在头图上 / 滚动后。
const navVariants = [
  { key: 'd', tag: 'D · 通栏实底（贴顶）', note: '不透明 --surface，底边一条细线，方角。最"是网页一部分"的一种。' },
  { key: 'e', tag: 'E · 只有一条细线', note: '完全没有底色，只靠底边一条 1px 细线和内容分开。最轻。' },
  { key: 'f', tag: 'F · 深色主题实底', note: '不透明的深主题色 + 白字。和像素画头图是同一个语汇。' },
  { key: 'g', tag: 'G · 胶囊 + 纯投影（无边框）', note: '保持现在的胶囊形状，但去掉边框、只用中性投影浮起来。' },
  { key: 'h', tag: 'H · 半透明贴顶（无圆角）', note: '主题色浅调 55% + 模糊，方角贴顶。半透明系里最"厚"的一种。' },
];
const navLinks = ['首页', '文章', '搜索', '关于'];

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const sample = posts[0]!;

const palettes = [
  {
    key: 'A',
    name: '现状 · 灰白紫',
    note: '现在站上这一套。中性灰底，稳妥但偏冷、偏“模板”。',
    colors: { bg: '#f7f8fa', surface: '#ffffff', fg: '#1f2430', muted: '#6b7280', line: '#e5e7eb', accent: '#4f46e5' },
  },
  {
    key: 'B',
    name: 'Firefly · 染色底',
    note: '页面底色带一层极淡的色相（这里是青绿），卡片纯白。不装壁纸也有氛围。',
    colors: { bg: '#edf3f0', surface: '#ffffff', fg: '#1f2724', muted: '#6b7a74', line: '#dbe6e1', accent: '#3f9c80' },
  },
  {
    key: 'C',
    name: '暖纸 · 琥珀',
    note: '米色纸感底 + 琥珀色强调。读长文最舒服，和你的算法笔记气质更搭。',
    colors: { bg: '#faf7f2', surface: '#fffdf9', fg: '#2b2622', muted: '#7c7268', line: '#e8e0d4', accent: '#b45309' },
  },
];
---

<BaseLayout title="样式展台" description="内部 A/B 对比页" noindex width="wide">
  <section class="mx-auto max-w-3xl py-12">
    <p class="text-sm font-medium text-accent">内部页面 · 不进导航 · noindex</p>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">样式展台</h1>
    <p class="mt-4 text-muted">
      这一页是给你<b>做决定</b>用的，不是给读者看的。每个小节把同一个零件用几套方案并排摆出来，
      你只需要说"A 还是 B"。
    </p>
    <div class="mt-6 rounded-xl border border-line bg-surface p-4 text-sm text-muted">
      <p><b class="text-fg">A</b> = 现状（记下来的基线）　<b class="text-fg">B</b> = Firefly 的做法　<b class="text-fg">C</b> = Reimu 的做法 / 我的备选</p>
      <p class="mt-1">某些小节只有 A 和 B——那说明第三个方案没有意义，摆上去只会增加噪音。</p>
    </div>
  </section>

  <!-- ① 文章卡造型 -->
  <section class="ab">
    <h2>① 文章卡造型</h2>
    <p class="ab-lead">看的是：封面位置、信息密度、第一眼的"个人主页感"。</p>
    <div class="ab-grid cols-3">
      <div class="ab-v">
        <span class="ab-tag a">A · 现状</span>
        <PostCard post={sample} />
        <p class="ab-note">竖版，封面 16:9 在上，摘要两行，干净但信息量小。</p>
      </div>
      <div class="ab-v">
        <span class="ab-tag b">B · Firefly 横向</span>
        <a href="#" class="card-b">
          <div class="card-b-text">
            <h3>{sample.data.title}</h3>
            <div class="card-b-meta"><span>2026/05/07</span><span>·</span><span>CSES</span></div>
            <p>{sample.data.description}</p>
            <div class="card-b-tags"><span>#Markdown</span><span>#CSES</span></div>
          </div>
          <img src={sample.data.cover} alt="" />
        </a>
        <p class="ab-note">横向，封面在右占 30%，左侧塞下标题+摘要+meta+标签。</p>
      </div>
      <div class="ab-v">
        <span class="ab-tag c">C · Reimu 斜切</span>
        <a href="#" class="card-c">
          <img src={sample.data.cover} alt="" />
          <div class="card-c-text">
            <h3>{sample.data.title}</h3>
            <p>{sample.data.description}</p>
            <div class="card-c-meta"><span>2026-05-07</span><span>3.8k 字</span><span>19 分钟</span></div>
          </div>
        </a>
        <p class="ab-note">封面左 40% 斜切，右侧信息行带字数/阅读时长。</p>
      </div>
    </div>
  </section>

  <!-- ② 容器宽度 -->
  <section class="ab">
    <h2>② 页面容器宽度</h2>
    <p class="ab-lead">看的是：一屏能放多少内容。按同一比例画出来。</p>
    <div class="ab-grid cols-1">
      <div class="ruler">
        <div class="ruler-row"><span class="ruler-label a">A · 1024px（现状）</span><div class="ruler-bar" style="width: 64%"></div></div>
        <div class="ruler-row"><span class="ruler-label b">B · 1600px（Firefly，xl 时收到 92vw）</span><div class="ruler-bar b" style="width: 100%"></div></div>
        <div class="ruler-row"><span class="ruler-label c">C · 1550px（Reimu）</span><div class="ruler-bar c" style="width: 97%"></div></div>
      </div>
    </div>
  </section>

  <!-- ③ 圆角与间距 -->
  <section class="ab">
    <h2>③ 圆角与卡片间距</h2>
    <p class="ab-lead">看的是：紧凑堆叠还是宽松留白。这是"气质"差异最直接的一处。</p>
    <div class="ab-grid cols-3">
      <div class="ab-v">
        <span class="ab-tag a">A · 16px / 24px（现状）</span>
        <div class="mock-cards gap-a"><div class="mock-card r16"></div><div class="mock-card r16"></div></div>
      </div>
      <div class="ab-v">
        <span class="ab-tag b">B · 16px / 16px（Firefly）</span>
        <div class="mock-cards gap-b"><div class="mock-card r16"></div><div class="mock-card r16"></div></div>
      </div>
      <div class="ab-v">
        <span class="ab-tag c">C · 12px / 32px（Reimu）</span>
        <div class="mock-cards gap-c"><div class="mock-card r12"></div><div class="mock-card r12"></div></div>
      </div>
    </div>
  </section>

  <!-- ④ 配色 -->
  <section class="ab">
    <h2>④ 全站配色</h2>
    <p class="ab-lead">看的是：气质。B/C 都是"页面底色带一点色相"的做法——不装壁纸也有氛围。</p>
    <div class="ab-grid cols-3">
      {palettes.map((p) => (
        <div class="ab-v">
          <span class:list={['ab-tag', p.key.toLowerCase()]}>{p.key} · {p.name}</span>
          <div class="palette" style={`background: ${p.colors.bg}`}>
            <div class="palette-card" style={`background: ${p.colors.surface}; border-color: ${p.colors.line}`}>
              <p style={`color: ${p.colors.fg}`} class="palette-title">算法笔记 01｜基础</p>
              <p style={`color: ${p.colors.muted}`} class="palette-desc">时间复杂度 $O(n \log n)$，空间复杂度 $O(n)$。</p>
              <span class="palette-btn" style={`background: ${p.colors.accent}`}>阅读</span>
            </div>
          </div>
          <div class="swatches">
            {Object.entries(p.colors).map(([name, value]) => (
              <span class="swatch" title={`${name}: ${value}`} style={`background: ${value}`}></span>
            ))}
          </div>
          <p class="ab-note">{p.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑤ 顶部导航 -->
  <section class="ab">
    <h2>⑤ 顶部导航</h2>
    <p class="ab-lead">看的是：导航是"网页的一部分"还是"浮在内容之上的一层玻璃"。下面三条都是真实渲染的，可以直接对比质感。</p>
    <div class="nav-stack">
      <div class="ab-v">
        <span class="ab-tag a">A · 现状：静态一行，底部分隔线</span>
        <div class="nav-a">
          <b>Wizard Note</b>
          <span class="nav-links"><a>首页</a><a>文章</a><a>搜索</a><a>关于</a></span>
        </div>
      </div>
      <div class="ab-v">
        <span class="ab-tag b">B · Firefly：悬浮胶囊 + 毛玻璃 + 底部圆角</span>
        <div class="nav-b-wrap">
          <div class="nav-b"><b>Wizard Note</b><span class="nav-links"><a>首页</a><a>文章</a><a>搜索</a><a>关于</a></span></div>
        </div>
      </div>
      <div class="ab-v">
        <span class="ab-tag c">C · Reimu：通栏 + 阴影 + 滚动隐藏</span>
        <div class="nav-c"><b>Wizard Note</b><span class="nav-links"><a>首页</a><a>文章</a><a>搜索</a><a>关于</a></span></div>
      </div>

      {
        navVariants.map((v) => (
          <div class="ab-v">
            <span class:list={['ab-tag', v.key]}>{v.tag}</span>
            <div class="nav-pair">
              <div class="nav-over">
                <div class:list={['nav-x', `nav-${v.key}`]}>
                  <b>Wizard Note</b>
                  <span class="nav-links">
                    {navLinks.map((label) => (
                      <a>{label}</a>
                    ))}
                  </span>
                </div>
              </div>
              <div class="nav-plain">
                <div class:list={['nav-x', `nav-${v.key}`]}>
                  <b>Wizard Note</b>
                  <span class="nav-links">
                    {navLinks.map((label) => (
                      <a>{label}</a>
                    ))}
                  </span>
                </div>
              </div>
            </div>
            <p class="ab-note">{v.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ⑥ 布局骨架 -->
  <section class="ab">
    <h2>⑥ 页面骨架</h2>
    <p class="ab-lead">看的是：要不要侧边栏。这是从"博客模板"变成"个人主页"最关键的一步。</p>
    <div class="ab-grid cols-3">
      <div class="ab-v">
        <span class="ab-tag a">A · 单栏（现状）</span>
        <div class="wire">
          <div class="wire-main"><div class="wire-block tall"></div><div class="wire-block"></div><div class="wire-block"></div></div>
        </div>
      </div>
      <div class="ab-v">
        <span class="ab-tag b">B · 左侧栏 + 正文</span>
        <div class="wire">
          <div class="wire-side"><div class="wire-block sm"></div><div class="wire-block sm"></div></div>
          <div class="wire-main"><div class="wire-block"></div><div class="wire-block"></div><div class="wire-block"></div></div>
        </div>
      </div>
      <div class="ab-v">
        <span class="ab-tag c">C · 左资料 + 中列表 + 右部件</span>
        <div class="wire">
          <div class="wire-side"><div class="wire-block sm"></div><div class="wire-block sm"></div></div>
          <div class="wire-main"><div class="wire-block"></div><div class="wire-block"></div></div>
          <div class="wire-side"><div class="wire-block sm"></div><div class="wire-block sm"></div><div class="wire-block sm"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑦ 代码块外观 -->
  <section class="ab">
    <h2>⑦ 代码块外观</h2>
    <p class="ab-lead">
      三个都已经是**真实的 Mac 窗口外观**（和正文里的代码块一模一样），差别只在行号与折叠。
      点 C 的右下角箭头试试展开。
    </p>
    <div class="ab-grid cols-3">
      <div class="ab-v">
        <span class="ab-tag a">A · 普通代码块（当前真实形态）</span>
        <div class="code-block lab-code">
          <div class="code-head">
            <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="code-lang">cpp</span>
            <span class="copy-btn">复制</span>
          </div>
          <pre class="code-demo"><code><span class="k">for</span> (<span class="t">int</span> i = <span class="n">0</span>; i &lt; n; i++) &#123;
  dp[i] = <span class="n">0</span>;
&#125;
<span class="c">// 简洁，但长代码难定位</span></code></pre>
        </div>
        <p class="ab-note">三色点 + 语言名 + 复制按钮，就这一层。</p>
      </div>

      <div class="ab-v">
        <span class="ab-tag b">B · 加行号</span>
        <div class="code-block lab-code">
          <div class="code-head">
            <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="code-lang">cpp</span>
            <span class="copy-btn">复制</span>
          </div>
          <pre class="code-demo ln"><code><span class="ln">238</span><span class="k">for</span> (<span class="t">int</span> i = <span class="n">0</span>; i &lt; n; i++) &#123;
<span class="ln">239</span>  dp[i] = <span class="n">0</span>;
<span class="ln">240</span>&#125;
<span class="ln">241</span><span class="c">// 讲题时能说"看第 239 行"</span></code></pre>
        </div>
        <p class="ab-note">行号列，讨论算法时很有用（成本：一个 Shiki transformer）。</p>
      </div>

      <div class="ab-v">
        <span class="ab-tag c">C · 折叠代码块（403 个题解的真实形态）</span>
        <div class="fold-code lab-code" data-fold-title="题解（C++）" data-collapsed="true">
          <div class="code-block">
            <div class="code-head">
              <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="code-title">题解（C++）</span>
              <span class="code-lang">cpp</span>
              <span class="code-lines">8 行</span>
              <span class="copy-btn">复制</span>
              <button class="code-toggle" type="button" aria-label="展开或收起">▾</button>
            </div>
            <pre class="code-demo"><code><span class="k">void</span> solve() &#123;
    <span class="t">long long</span> n;
    cin &gt;&gt; n;
    <span class="k">while</span> (n != <span class="n">1</span>) &#123;
        cout &lt;&lt; n &lt;&lt; <span class="s">' '</span>;
        n = (n % <span class="n">2</span> == <span class="n">0</span>) ? n / <span class="n">2</span> : n * <span class="n">3</span> + <span class="n">1</span>;
    &#125;
&#125;</code></pre>
          </div>
        </div>
        <p class="ab-note">
          <b>这就是刚改完的形态</b>：折叠标题、语言、行数、复制、展开按钮全在<b>同一条</b> Mac 标题栏里，
          不再是「折叠一条栏 + 代码一条栏」两层。
        </p>
      </div>
    </div>
  </section>

  <!-- ⑧ hover -->
  <section class="ab">
    <h2>⑧ 卡片 hover 手感</h2>
    <p class="ab-lead">把鼠标移到下面三张卡上，感受差别（触屏设备看不出效果）。</p>
    <div class="ab-grid cols-3">
      <div class="ab-v">
        <span class="ab-tag a">A · 现状：上浮 2px + 阴影</span>
        <div class="hover-a"><img src={sample.data.cover} alt="" /><b>{sample.data.title}</b></div>
      </div>
      <div class="ab-v">
        <span class="ab-tag b">B · Firefly：封面放大 + 暗色遮罩</span>
        <div class="hover-b"><img src={sample.data.cover} alt="" /><b>{sample.data.title}</b></div>
      </div>
      <div class="ab-v">
        <span class="ab-tag c">C · Reimu：整卡放大 1.01 + 图 1.05</span>
        <div class="hover-c"><img src={sample.data.cover} alt="" /><b>{sample.data.title}</b></div>
      </div>
    </div>
  </section>

  <!-- ⑨ 主题切换 -->
  <section class="ab">
    <h2>⑨ 深浅色切换动效</h2>
    <p class="ab-lead">点三个按钮，看过渡方式的差别。</p>
    <div class="ab-grid cols-3">
      <div class="ab-v">
        <span class="ab-tag a">A · 瞬间切换</span>
        <button class="demo-btn" data-theme-mode="instant">切换试试</button>
      </div>
      <div class="ab-v">
        <span class="ab-tag b">B · 颜色过渡 0.15s</span>
        <button class="demo-btn" data-theme-mode="transition">切换试试</button>
      </div>
      <div class="ab-v">
        <span class="ab-tag c">C · 圆形扩散（View Transitions）</span>
        <button class="demo-btn" data-theme-mode="circle">切换试试</button>
      </div>
    </div>
  </section>

  <!-- ⑪ 色相选择器已搬到导航栏（那个调色板图标） -->
  <section class="ab">
    <h2>⑪ 全站色相选择器</h2>
    <p class="ab-lead">
      已搬到<b>导航栏右上角的调色板图标</b>里——点开就能拖色相、点预设色块。
      整站颜色（底色、强调色、代码框、描边）由一个 <code>--hue</code> 数字驱动，
      要让所有人生效就写进 <code>src/consts.ts</code> 的 <code>SITE_HUE</code>。
    </p>
  </section>

  <!-- ⑩ 阅读进度 -->
  <section class="ab">
    <h2>⑩ 顶部阅读进度条</h2>
    <p class="ab-lead">真站里它会固定在视口顶部，随滚动填充。这里点按钮模拟一次。</p>
    <div class="ab-grid cols-1">
      <div class="ab-v">
        <div class="progress-demo"><span></span></div>
        <button class="demo-btn" data-progress>播放一次</button>
        <p class="ab-note">成本约 15 行 JS + 5 行 CSS。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ab {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }
  .ab h2 {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .ab-lead {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .ab-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .ab-grid.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .ab-grid.cols-1 {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (max-width: 900px) {
    .ab-grid.cols-3 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .ab-v {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }
  .ab-tag {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }
  .ab-tag.a {
    background: #e5e7eb;
    color: #374151;
  }
  .ab-tag.b {
    background: #d7efe6;
    color: #14684f;
  }
  .ab-tag.c {
    background: #fbe3e6;
    color: #a8324a;
  }
  .ab-note {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---- ① 卡片造型 ---- */
  .card-b {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    text-decoration: none !important;
    color: inherit;
    min-height: 11rem;
  }
  .card-b-text {
    flex: 1;
    min-width: 0;
  }
  .card-b-text h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .card-b-meta,
  .card-c-meta {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .card-b-text p {
